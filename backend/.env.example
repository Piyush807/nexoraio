# Copy this file to .env in the backend/ directory and fill in real values.
# BackendApplication loads .env automatically at startup (and will fall back
# to real OS/container environment variables if no .env file is present).

# PostgreSQL connection
DB_URL=jdbc:postgresql://localhost:5432/nexora
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT access-token signing secret (Base64-encoded, 256+ bits) and expiration
# in milliseconds. Generate one with: openssl rand -base64 32
JWT_SECRET=replace-with-a-base64-encoded-secret-at-least-32-bytes-long
JWT_EXPIRATION=86400000

# Refresh-token lifetime in ms. Optional - defaults to 7 days if unset.
# JWT_REFRESH_EXPIRATION=604800000

# Set to true in any real (https) deployment. Leave unset/false so the
# refresh-token cookie still works over plain http://localhost in dev.
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=Strict

# Only needed if you switch GeminiClient to be the active AI provider
# (currently OllamaClient is @Primary, so this can stay blank for local
# dev against a running Ollama instance at localhost:11434).
GEMINI_API_KEY=
